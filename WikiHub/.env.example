# WikiHub .env.example — 模板（不包含真实 key）
#
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
#   vim .env
#
# 命名空间 WIKIHUB_* 与 ThinkWiki 的 THINKWIKI_* 完全独立，
# 两个 skill 在同一台机器上可以并存而不互相覆盖。

# ======================================================================
# LLM（ask / query / crystallize / digest 流程必用）
# ======================================================================
# 用于 AI 问答、生成 query 页、生成 synthesis 页
# 走 OpenAI 兼容端点；任何 /v1/chat/completions 风格的服务都行
#
# 例子：
#   - MiniMax M3:  WIKIHUB_LLM_BASE_URL=https://api.minimaxi.com/v1
#                  WIKIHUB_LLM_MODEL=MiniMax-M3
#   - OpenAI:      WIKIHUB_LLM_BASE_URL=https://api.openai.com/v1
#                  WIKIHUB_LLM_MODEL=gpt-4o-mini
#   - 本地 Ollama: WIKIHUB_LLM_BASE_URL=http://127.0.0.1:11434/v1
#                  WIKIHUB_LLM_MODEL=qwen2.5:7b
#                  （注意 Ollama 某些模型可能没 completions 端点）

WIKIHUB_LLM_API_KEY=
WIKIHUB_LLM_BASE_URL=
WIKIHUB_LLM_MODEL=
# 可选：覆盖温度（0.0-1.0）；不设则走 kind 内的默认值（concept=0.3, decision=0.3, synthesis=0.5, query=0.7）
WIKIHUB_LLM_TEMPERATURE=

# ======================================================================
# Embedding（**可选** — 仅 entity-merge-review 流程用）
# ======================================================================
# 用于给 entity 标签算 embedding，用 cosine similarity 找出
# "语义重复但命名不同"的 entity 候选合并。
#
# 不配也完全可用 —— review 退化为字符串匹配（找字面相同的 entity）。
# ask / graph / viewer / build / clip / batch-ingest / rebuild
# 这些核心流程 **完全不依赖** 嵌入，ask 用的是 token 重叠 + n-gram 匹配。
#
# 例子（本地 Ollama）：
#   WIKIHUB_EMBED_BASE_URL=http://127.0.0.1:11434/v1/embeddings
#   WIKIHUB_EMBED_MODEL=bge-m3
#   WIKIHUB_EMBED_API_KEY=ollama   # Ollama 接受任意非空字符串
#
# 例子（SiliconFlow 云端）：
#   WIKIHUB_EMBED_BASE_URL=https://api.siliconflow.cn/v1/embeddings
#   WIKIHUB_EMBED_MODEL=BAAI/bge-m3
#   WIKIHUB_EMBED_API_KEY=sk-...

WIKIHUB_EMBED_API_KEY=
WIKIHUB_EMBED_BASE_URL=
WIKIHUB_EMBED_MODEL=